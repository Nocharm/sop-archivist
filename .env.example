# 복사해서 사용: cp .env.example .env  (.env는 git에 커밋하지 않음)
# 이 루트 .env는 docker-compose용이다. 로컬 네이티브 backend는 backend/.env(또는 shell export)를 읽는다.
# backend 설정은 settings.py · 이 파일 · docker-compose.yml(backend environment)에 함께 둔다.

# --- 서버 docker-compose용 ---
# 앱 nginx가 호스트에 노출되는 포트 (엣지 nginx 443/80, bpm 9900·9910과 충돌 금지)
# 포트를 바꾸면 Keycloak 클라이언트에 그 origin을 등록해야 로그인이 된다
APP_PORT=7777
# backend(uvicorn)가 X-Forwarded-For를 믿을 프록시 대역 — compose 네트워크의 실제 서브넷.
# 대역은 자동 할당이라, 첫 기동 뒤 `docker network inspect sop-archivist_default`로 확인해 적고
# `docker compose up -d backend && docker compose restart proxy`로 다시 올린다(nginx는 시작할 때 푼 backend 주소를
# 계속 쓰므로 proxy도 재시작). 비우면 backend 접속 로그의 클라이언트 주소가 nginx 주소로 찍힌다
# FORWARDED_ALLOW_IPS=<compose-subnet>

POSTGRES_USER=sop_archivist
# 서버는 강한 임의값(예: openssl rand -hex 24). 이 값이 backend DATABASE_URL에 그대로 들어가므로 URL에 안전한
# 문자(영문·숫자·-_.)만 쓴다. postgres 비밀번호는 볼륨을 처음 만들 때만 적용되니 첫 up 전에 확정한다.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sop_archivist

# --- DB 자동 백업 (db-backup 사이드카 — 정책·복구: docs/deploy/backup.md) ---
# 덤프 저장 위치(호스트 경로, 상대 경로는 저장소 루트 기준). 서버 디스크에만 두면
# 디스크 장애 시 백업도 유실 — 오프서버 사본 절차는 런북 참고.
BACKUP_DIR=./backups
# 덤프 보존 일수 — 초과분은 매 백업 후 자동 삭제
BACKUP_RETENTION_DAYS=14

# --- db-viewer 읽기전용 조회 (docs/deploy/db-viewer-readonly.md) ---
# db 컨테이너가 추가로 합류하는 공유 브리지(external — db-viewer 운영자가 서버에서 먼저 생성).
# 별칭은 공유 네트워크 안에서 유일해야 한다 — bpm 별칭(bpm-db)과 겹치면 엉뚱한 DB에 붙는다.
DBV_NETWORK=dbv-shared
DBV_DB_ALIAS=sop-archivist-db

# --- 로컬 네이티브 실행용 (Docker 없음) ---
# backend DB — 기본은 무설정 sqlite 파일. 로컬 Postgres를 쓰면 아래 줄로 교체:
#   DATABASE_URL=postgresql+asyncpg://sop_archivist:change-me@localhost:5432/sop_archivist
# (서버 compose는 이 값을 쓰지 않고 POSTGRES_*로 DATABASE_URL을 직접 만든다)
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# frontend dev 서버가 /api 를 프록시할 backend 주소 (next.config.ts rewrites)
BACKEND_URL=http://localhost:8777

# --- 인증 ---
# 인증 모드 — keycloak(운영 OIDC) | dev(로컬 우회: X-Dev-User 헤더를 신뢰). 서버는 반드시 keycloak.
# compose는 이 값이 비어 있어도 keycloak으로 닫는다. 로컬 검증은 AUTH_MODE=dev.
AUTH_MODE=keycloak
KEYCLOAK_ISSUER=http://<keycloak-host>:8080/realms/ai-portal
# 토큰 aud 검증값 (비우면 생략)
KEYCLOAK_AUDIENCE=
# Keycloak에 등록한 public 클라이언트 ID — backend는 토큰의 azp가 이 값과 같을 때만 받는다(비면 전부 거부)
KEYCLOAK_CLIENT_ID=sop-archivist-frontend
# dev 모드에서 X-Dev-User 헤더가 없을 때 쓰는 사용자 loginId (기본 dev.admin)
# DEV_USER=dev.admin
# 시스템 관리자 loginId 콤마 구분 — 권한 표와 무관하게 모든 권한을 갖는다.
# 로컬 dev 예시값 dev.admin. 서버에서는 실제 Keycloak 로그인 아이디로 교체한다 — 비우면 서버에 관리자가 0명이다.
APP_SYSADMINS=dev.admin
# dev 모드에서도 실제 권한 판정을 적용할지. false(기본) = dev 사용자는 전권(로컬 잠금 방지).
# true로 두면 APP_SYSADMINS 외에는 부여된 권한만 적용 — keycloak 스택에서는 무의미.
DEV_ENFORCE_PERMISSIONS=false

# --- 온프레미스 AI (OpenAI 호환 GPU 서버) ---
# 로컬은 비활성이 기본. 로컬 배선 확인은 가짜 AI(node frontend/scripts/fake-ai-server.mjs, :9999)로 한다:
#   AI_ENABLED=true  AI_BASE_URL=http://localhost:9999/v1  AI_API_TOKEN=fake
# 토큰이 비면 Authorization: Bearer 헤더가 깨져 호출이 실패하므로 가짜 서버에도 아무 값이나 넣는다.
# 서버는 AI_BASE_URL=https://<ai-host>/v1 와 실제 모델·토큰. AI_API_TOKEN은 시크릿 — 커밋 금지.
AI_ENABLED=false
AI_BASE_URL=http://localhost:9999/v1
AI_API_TOKEN=fake
AI_MODEL=
# 호출 1회 타임아웃 — 느린 온프레미스 GPU는 120~180 권장(최대 사고 모드는 오래 걸릴 수 있음)
AI_TIMEOUT_SECONDS=60
# 응답 max_tokens 상한 — 사고(thinking) 토큰 포함. 너무 작으면 GLM이 빈 응답 반환(최대 사고 기준 ≥2000)
AI_MAX_TOKENS=8000
# 다중 엔드포인트+모델 (선택) — JSON 배열 한 줄. 설정하면 위 AI_BASE_URL/AI_API_TOKEN/AI_MODEL 대신 사용.
# 항목: name(필수)·base_url(필수)·token·model(기본 모델)·models(노출 목록 — 비우면 /models 자동 조회). 예:
#   AI_ENDPOINTS=[{"name":"GPU","base_url":"http://<ai-host>:8000/v1","token":"...","model":"<model>","models":["<model>"]}]
AI_ENDPOINTS=
# AI 부하 가드 — 백엔드 전체 동시 AI 호출 상한
AI_MAX_CONCURRENCY=4

# --- 사내 n8n HR 웹훅 동기화 ---
# 사용자·조직도 단일 소스. 둘 다 비우면 비활성(로컬 개발). 시크릿(N8N_HR_TOKEN)은 커밋 금지.
N8N_HR_URL=http://<n8n-host>:5678/webhook/hr-dept
N8N_HR_TOKEN=
# 자동 동기화 주기(시간). 0 = off. 최초 배포는 0으로 두고 드라이런(프리뷰) → 첫 수동 동기화 확인 뒤 24로 올린다
HR_SYNC_INTERVAL_HOURS=24
# 전체 동기화 삭제 상한(배치 관리 행 대비 %). 0 = 가드 끔
HR_SYNC_DELETE_CAP_PCT=20
